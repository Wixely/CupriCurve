<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Package metadata (applied when a project opts into packing; see src/Directory.Build.props). -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Wixely</Authors>
    <Company>Wixely</Company>
    <Product>CupriCurve</Product>
    <Description>CupriCurve — constant-time managed Curve25519/Ed25519 group arithmetic with Tor-style Ed25519 key blinding.</Description>
    <PackageProjectUrl>https://github.com/Wixely/CupriCurve</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Wixely/CupriCurve</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ed25519;curve25519;cryptography;managed;constant-time;key-blinding</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Only projects that opt in (src/) are packable; tests are not. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
